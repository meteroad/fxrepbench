        "dry_level": {"api_min": 0.0, "api_max": 1.0, "prior_min": null, "prior_max": null, "distribution": "fixed", "fixed": 0.5},
        "width": {"api_min": 0.0, "api_max": 1.0, "prior_min": 0.0, "prior_max": 1.0, "distribution": "linear", "fixed": null},
        "freeze_mode": {"api_min": 0.0, "api_max": 1.0, "prior_min": null, "prior_max": null, "distribution": "fixed", "fixed": 0.0}
