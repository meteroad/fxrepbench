        "ratio": {"api_min": 1.0, "api_max": 20.0, "prior_min": 1.5, "prior_max": 12.0, "distribution": "log", "fixed": null},
        "attack_ms": {"api_min": 0.01, "api_max": 200.0, "prior_min": 0.1, "prior_max": 100.0, "distribution": "log", "fixed": null},
        "release_ms": {"api_min": 1.0, "api_max": 1000.0, "prior_min": 20.0, "prior_max": 500.0, "distribution": "log", "fixed": null}
      }
    },
    "distortion": {
