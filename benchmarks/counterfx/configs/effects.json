{
  "schema_version": "1.0",
  "normalization": {
    "authoritative_space": "benchmark_prior",
    "linear": "u=(x-min)/(max-min)",
    "log": "u=(log(x)-log(min))/(log(max)-log(min))",
    "note": "Recompute normalized values from physical controls. Legacy normalized fields in frozen target manifests used plugin API bounds and are retained only for provenance."
  },
  "effect_order": [
    "highpass_filter",
    "lowpass_filter",
    "peak_filter",
    "compressor",
    "distortion",
    "chorus",
    "delay",
    "reverb"
  ],
  "effects": {
    "highpass_filter": {
      "label": "High-pass filter",
      "pedalboard_class": "HighpassFilter",
      "parameters": {
        "cutoff_frequency_hz": {"api_min": 20.0, "api_max": 18000.0, "prior_min": 30.0, "prior_max": 1200.0, "distribution": "log", "fixed": null}
      }
    },
    "lowpass_filter": {
      "label": "Low-pass filter",
      "pedalboard_class": "LowpassFilter",
      "parameters": {
        "cutoff_frequency_hz": {"api_min": 20.0, "api_max": 18000.0, "prior_min": 2000.0, "prior_max": 18000.0, "distribution": "log", "fixed": null}
      }
    },
    "peak_filter": {
